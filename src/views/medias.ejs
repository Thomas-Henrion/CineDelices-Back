<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <p>Liste de médias</p>
    
    <ul>
        <% medias.forEach(media => { %>
            <img src="<%= media.image %>" alt="Image de <%= media.title %>">
            <li><%= media.title  %> </li>
            <li><%= media.anecdote %> </li>
            <li><a href="/admin/medias/<%= media.id %>">Détails</a></li>
        <% }) %>
    </ul>

    <a href="/admin/medias/create">Ajouter un média</a>
</body>
</html>