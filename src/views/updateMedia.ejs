<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <form method="post">

        <label for="title">Titre</label>
        <input type="text" name="title" id="title" value="<%= media.title %>">
        
        <label for="anecdote">Anecdote</label>
        <input type="text" name="anecdote" id="anecdote" value="<%= media.anecdote %>">
        
        <label for="image">Image</label>
        <input type="text" name="coverImage" id="image" value="<%= media.image %>">
        
        <button type="submit">Modifier</button>
        <button type="reset">Annuler</button>
       
        
    </form>
    
</body>
</html>