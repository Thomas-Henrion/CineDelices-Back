<%- include('../partials/header.ejs') %>

<h1>Inscription</h1>

<!-- Toast en cas d'erreur -->
<% if (typeof errors !== "undefined") { %>
  
  <div class="alert alert-danger" role="alert">
    <% for (const errorAttribute in errors) { %>
      <%- errors[errorAttribute] %> <br>
      <% } %>
    </div>
<% } %>
    
<form action="" method="POST">
<!-- le code ci dessus est un ternaire, si la condition est vrai le premier element après le ? s'affiche si c'est faut c'est l'élément après les : -->
  <label class="form-label h4" for="username">Username</label>
  <input class="form-control mb-4" type="username" id="username" name="username" placeholder="Nom" value="<%= typeof data !== "undefined" && data.username ? data.username : '' %>">

  <label class="form-label h4" for="email">Email</label>
  <input class="form-control mb-4" type="email" id="email" name="email" placeholder="email@domain.com" value="<%= typeof data !== "undefined" && data.email ? data.email : '' %>">

  <label class="form-label h4" for="password">Mot de passe</label>
  <input class="form-control" type="password" id="password" name="password" placeholder="*********">

  <label class="form-label h4" for="confirmation">Confirmation mot de passe</label>
  <input class="form-control" type="password" id="confirmation" name="confirmation" placeholder="*********">
  
  <input class="btn btn-primary d-block my-4 mx-auto" type="submit" value="S'inscrire">
</form>

<%- include('../partials/footer.ejs') %>